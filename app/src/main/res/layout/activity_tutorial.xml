<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tutorialTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/tutorial_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <systems.drakonix.picross.PicrossView
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ToggleButton
            android:id="@+id/toolFill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="@string/tool_fill"
            android:textOn="@string/tool_fill" />

        <ToggleButton
            android:id="@+id/toolMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="@string/tool_mark"
            android:textOn="@string/tool_mark" />

        <ToggleButton
            android:id="@+id/toolPan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="@string/tool_pan"
            android:textOn="@string/tool_pan" />
    </LinearLayout>

    <TextView
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="4"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/stepCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_back" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_play" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_next" />
    </LinearLayout>

    <Button
        android:id="@+id/tryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/tutorial_try"
        android:visibility="gone" />
</LinearLayout>
