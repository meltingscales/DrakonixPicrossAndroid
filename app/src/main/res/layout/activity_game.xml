<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/gameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textSize="20sp"
        android:textStyle="bold" />

    <systems.drakonix.picross.PicrossView
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ToggleButton
            android:id="@+id/toolFill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="@string/tool_fill"
            android:textOn="@string/tool_fill" />

        <ToggleButton
            android:id="@+id/toolMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="@string/tool_mark"
            android:textOn="@string/tool_mark" />

        <ToggleButton
            android:id="@+id/toolPan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOff="@string/tool_pan"
            android:textOn="@string/tool_pan" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/resetViewButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_view" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset" />
    </LinearLayout>
</LinearLayout>
